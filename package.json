{
  "name": "npm-catalog",
  "displayName": "NPM Catalog",
  "description": "Keep npm dependencies up to date: see outdated, vulnerable and deprecated packages across your project or monorepo and update them in one click. Plus a curated package catalog.",
  "version": "0.2.0",
  "publisher": "Denys-Shovkovyi",
  "license": "MIT",
  "icon": "media/marketplace-icon.png",
  "galleryBanner": {
    "color": "#0e1116",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Denissholkovy/npm-catalog"
  },
  "homepage": "https://github.com/Denissholkovy/npm-catalog#readme",
  "bugs": {
    "url": "https://github.com/Denissholkovy/npm-catalog/issues"
  },
  "keywords": [
    "npm",
    "dependencies",
    "update",
    "outdated",
    "upgrade",
    "npm-check-updates",
    "security",
    "vulnerabilities",
    "audit",
    "monorepo",
    "workspaces",
    "pnpm",
    "yarn",
    "bun",
    "package.json",
    "packages",
    "catalog",
    "explorer"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "workspaceContains:package.json"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "npmCatalog",
          "title": "NPM Catalog",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "npmCatalog": [
        {
          "id": "npmCatalogView",
          "name": "Dependencies",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "npmCatalog.refresh",
        "title": "Refresh All Categories",
        "icon": "$(refresh)",
        "category": "NPM Catalog"
      },
      {
        "command": "npmCatalog.searchPackages",
        "title": "Search npm Packages",
        "icon": "$(search)",
        "category": "NPM Catalog"
      },
      {
        "command": "npmCatalog.showProjectDependencies",
        "title": "Show Dependency Updates",
        "icon": "$(package)",
        "category": "NPM Catalog"
      },
      {
        "command": "npmCatalog.updateAllDependencies",
        "title": "Update All Dependencies…",
        "icon": "$(arrow-up)",
        "category": "NPM Catalog"
      },
      {
        "command": "npmCatalog.openPackage",
        "title": "Open Package by Name…",
        "icon": "$(go-to-file)",
        "category": "NPM Catalog"
      },
      {
        "command": "npmCatalog.clearSearch",
        "title": "Clear Search",
        "icon": "$(close)",
        "category": "NPM Catalog"
      },
      {
        "command": "npmCatalog.clearSearchHistory",
        "title": "Clear Search History",
        "category": "NPM Catalog"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "npmCatalog.searchPackages",
          "when": "view == npmCatalogView",
          "group": "navigation@2"
        },
        {
          "command": "npmCatalog.clearSearch",
          "when": "view == npmCatalogView && npmCatalog.hasActiveSearch",
          "group": "navigation@3"
        },
        {
          "command": "npmCatalog.showProjectDependencies",
          "when": "view == npmCatalogView",
          "group": "more@0"
        },
        {
          "command": "npmCatalog.refresh",
          "when": "view == npmCatalogView",
          "group": "navigation@4"
        },
        {
          "command": "npmCatalog.openPackage",
          "when": "view == npmCatalogView",
          "group": "more@1"
        },
        {
          "command": "npmCatalog.clearSearchHistory",
          "when": "view == npmCatalogView",
          "group": "more@2"
        },
        {
          "command": "npmCatalog.updateAllDependencies",
          "when": "view == npmCatalogView",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "NPM Catalog",
      "properties": {
        "npmCatalog.pageSize": {
          "type": "number",
          "default": 20,
          "minimum": 5,
          "maximum": 50,
          "description": "How many packages to load per page."
        },
        "npmCatalog.cacheTtlHours": {
          "type": "number",
          "default": 24,
          "minimum": 0,
          "description": "How long cached category results stay fresh, in hours."
        },
        "npmCatalog.packageManager": {
          "type": "string",
          "enum": [
            "auto",
            "npm",
            "yarn",
            "pnpm",
            "bun"
          ],
          "default": "auto",
          "description": "Package manager used for install commands. \"auto\" detects it from the lock file."
        },
        "npmCatalog.checkOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Check the workspace for outdated and vulnerable dependencies when VS Code starts."
        },
        "npmCatalog.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the number of available updates in the status bar."
        }
      }
    }
  },
  "scripts": {
    "test": "echo \"No tests yet\""
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  }
}
