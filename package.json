{
  "name": "npm-catalog",
  "displayName": "NPM Catalog",
  "description": "Browse the most popular npm packages by category — Frontend, Backend, Mobile, and more — right from the sidebar.",
  "version": "0.1.5",
  "publisher": "Denys-Shovkovyi",
  "license": "MIT",
  "icon": "media/marketplace-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Denissholkovy/npm-catalog"
  },
  "keywords": [
    "npm",
    "packages",
    "catalog",
    "react",
    "node",
    "react-native",
    "explorer",
    "dependencies"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "npmCatalog",
          "title": "NPM Catalog",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "npmCatalog": [
        {
          "id": "npmCatalogView",
          "name": "Packages",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "npmCatalog.refresh",
        "title": "Refresh All Categories",
        "icon": "$(refresh)",
        "category": "NPM Catalog"
      },
      {
        "command": "npmCatalog.searchPackages",
        "title": "Search Packages",
        "icon": "$(search)",
        "category": "NPM Catalog"
      },
      {
        "command": "npmCatalog.clearSearch",
        "title": "Clear Search",
        "icon": "$(close)",
        "category": "NPM Catalog"
      },
      {
        "command": "npmCatalog.clearSearchHistory",
        "title": "Clear Search History",
        "category": "NPM Catalog"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "npmCatalog.searchPackages",
          "when": "view == npmCatalogView",
          "group": "navigation@1"
        },
        {
          "command": "npmCatalog.clearSearch",
          "when": "view == npmCatalogView && npmCatalog.hasActiveSearch",
          "group": "navigation@2"
        },
        {
          "command": "npmCatalog.refresh",
          "when": "view == npmCatalogView",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "NPM Catalog",
      "properties": {
        "npmCatalog.pageSize": {
          "type": "number",
          "default": 20,
          "minimum": 5,
          "maximum": 50,
          "description": "How many packages to load per page."
        },
        "npmCatalog.cacheTtlHours": {
          "type": "number",
          "default": 24,
          "minimum": 0,
          "description": "How long cached category results stay fresh, in hours."
        },
        "npmCatalog.packageManager": {
          "type": "string",
          "enum": [
            "auto",
            "npm",
            "yarn",
            "pnpm",
            "bun"
          ],
          "default": "auto",
          "description": "Package manager used for install commands. \"auto\" detects it from the lock file."
        }
      }
    }
  },
  "scripts": {
    "test": "echo \"No tests yet\""
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  }
}
